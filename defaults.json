{
	"version": 1,
	"theme": {
		"colors": {
			"background": "#1D2022",
			"surface": "#1D2022",
			"border": "#3C3C3C",
			"muted": "#3C3C3C",
			"text": "#EBDBB2",
			"primary": "#AD685A",
			"secondary": "#98971A",
			"tertiary": "#458588"
		},
		"fonts": {
			"family": "Cantarell",
			"size": 14
		},
		"spacing": {
			"margin": 10,
			"padding": 8,
			"borderWidth": 2,
			"borderRadius": 13
		}
	},
	"bar": {
		"enabled": true,
		"layouts": {
			"*": {
				"left": [],
				"center": ["workspaces"],
				"right": []
			}
		},
		"spacing": {
