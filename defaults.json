		"width": 240,
		"imageSize": 64,
		"maxChars": 30,
		"fonts": {
			"sizeApp": 10,
			"sizeSummary": 14,
			"sizeBody": 12
		}
	},
	"polling": {
		"default": 2000,
		"clock": 1000
